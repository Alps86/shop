package e2ediag

import (
	"context"
	"encoding/json"
	"errors"
	"net"
	"net/http"
	"os"
	"path/filepath"
	"runtime/pprof"
	"runtime/trace"
	"time"
)

func Bootstrap() (func(), error) {
	if os.Getenv("SHOP_E2E_PROFILE") != "1" {
		return func() {
		}, nil
	}

	profiler := &Profiler{state: "idle", directory: "/tmp/shop-e2e-private"}
	mux := http.NewServeMux()
	mux.HandleFunc("POST /start", profiler.start)
	mux.HandleFunc("POST /stop", profiler.stop)
	listener, err := net.Listen("tcp", "127.0.0.1:6061")
	if err != nil {
		return nil, err
	}

	profiler.listener = &http.Server{Handler: mux, ReadHeaderTimeout: time.Second}
	go profiler.serve(listener)

	return profiler.close, nil
}

func (profiler *Profiler) serve(listener net.Listener) {
	err := profiler.listener.Serve(listener)
	if !errors.Is(err, http.ErrServerClosed) {
		profiler.close()
	}
}

func (profiler *Profiler) start(writer http.ResponseWriter, _ *http.Request) {
	profiler.mutex.Lock()
	defer profiler.mutex.Unlock()
	if profiler.state != "idle" {
		http.Error(writer, "already-started", 409)
		return
	}

	profiler.state = "starting"
	if err := profiler.open(); err != nil {
		profiler.finish("failed")
		http.Error(writer, "start-unavailable", 503)

		return
	}

	profiler.state = "running"
	profiler.timer = time.AfterFunc(60*time.Second, profiler.expire)
	writer.WriteHeader(204)
}

func (profiler *Profiler) open() error {
	if err := os.MkdirAll(profiler.directory, 0700); err != nil {
		return err
	}

	cpu, err := os.OpenFile(filepath.Join(profiler.directory, "cpu.pprof"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
	profiler.cpu = cpu
	if err != nil {
		return err
	}

	execution, err := os.OpenFile(filepath.Join(profiler.directory, "execution.trace"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
	profiler.execution = execution
	if err != nil {
		return err
	}

	return profiler.activate()
}

func (profiler *Profiler) activate() error {
	if err := pprof.StartCPUProfile(profiler.cpu); err != nil {
		return err
	}

	profiler.cpuStarted = true
	if err := trace.Start(profiler.execution); err != nil {
		return err
	}

	profiler.traceStarted = true

	return nil
}

func (profiler *Profiler) stop(writer http.ResponseWriter, _ *http.Request) {
	profiler.mutex.Lock()
	defer profiler.mutex.Unlock()
	if profiler.state != "running" {
		http.Error(writer, "not-running", 409)
		return
	}

	profiler.finish("stopped")
	if profiler.state != "stopped" {
		http.Error(writer, "stop-unavailable", 503)
		return
	}

	writer.WriteHeader(204)
}

func (profiler *Profiler) expire() {
	profiler.mutex.Lock()
	defer profiler.mutex.Unlock()
	if profiler.state == "running" {
		profiler.finish("expired")
	}
}

func (profiler *Profiler) finish(state string) {
	if profiler.timer != nil {
		profiler.timer.Stop()
	}

	if profiler.traceStarted {
		trace.Stop()
		profiler.traceStarted = false
	}

	if profiler.cpuStarted {
		pprof.StopCPUProfile()
		profiler.cpuStarted = false
	}

	profiler.state = state
	profiler.closeFiles()
	profiler.saveState()
}

func (profiler *Profiler) closeFiles() {
	for _, file := range []*os.File{profiler.cpu, profiler.execution} {
		if err := closeFile(file); err != nil {
			profiler.state = "close-failed"
		}
	}

	profiler.cpu = nil
	profiler.execution = nil
}

func closeFile(file *os.File) error {
	if file == nil {
		return nil
	}

	return file.Close()
}

func (profiler *Profiler) saveState() {
	data, err := json.Marshal(ProfileState{State: profiler.state, UTC: time.Now().UTC(), PID: os.Getpid()})
	if err != nil {
		profiler.state = "metadata-failed"
		return
	}

	if err := os.WriteFile(filepath.Join(profiler.directory, "state.json"), data, 0600); err != nil {
		profiler.state = "metadata-failed"
	}
}

func (profiler *Profiler) close() {
	profiler.mutex.Lock()
	if profiler.state == "running" {
		profiler.finish("closed")
	}
	profiler.mutex.Unlock()
	if profiler.listener != nil {
		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
		defer cancel()
		if err := profiler.listener.Shutdown(ctx); err != nil {
			return
		}
	}
}
